NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Comma-separated list of allowed browser origins (React admin)
CORS_ORIGINS=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=samudaysetu

# 32+ char secret. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=60

# Public origin that join links and QR codes point at (the member-facing app,
# NOT this API). Configure it as an App Link / Universal Link so installed users
# land in the Flutter app instead of the web page.

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_PER_PHONE_PER_HOUR=3

# Origin the join link points at. It is printed on posters and forwarded on
# WhatsApp, so it must be a host the public can reach — never localhost in any
# deployed environment. The backend serves the /join and /invite landing pages
# and the app-link association files from this origin itself.
PUBLIC_APP_BASE_URL=https://samudaysetu.onrender.com
MOBILE_DEEP_LINK_SCHEME=samudaysetu

# App Links / Universal Links. Until these are filled in, /.well-known/* returns
# 404 and every join URL opens the web landing page instead of the app — a
# correct fallback, not a broken one.
#
# ANDROID_CERT_FINGERPRINTS: uppercase SHA-256, colon-separated, comma-separated
# for multiple. With Play App Signing there are TWO — the upload key and the
# key Google re-signs with. Play Console -> Setup -> App integrity.
ANDROID_PACKAGE_NAME=com.headway.samudaysetu.samudaysetu
ANDROID_CERT_FINGERPRINTS=
# <TeamID>.<BundleID>, e.g. A1B2C3D4E5.com.headway.samudaysetu
IOS_APP_ID=

# Store listings, linked from the web landing page. Omitted from the page when empty.
ANDROID_STORE_URL=
IOS_STORE_URL=
