<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Android 9+ blocks plaintext HTTP by default, so a debug build talking to
         http://10.0.2.2:4000 fails with a bare connection error.

         This override lives in the *debug* manifest only. Putting it in the main
         manifest would ship a release build that silently accepts downgraded,
         interceptable connections. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
